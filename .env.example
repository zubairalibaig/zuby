# ---------------------------------------------------------------------------
# Zuby environment variables. Copy to .env.local and fill in.
# NEVER commit .env.local — it is gitignored.
# ---------------------------------------------------------------------------

# Supabase project URL and anon key.
# Dashboard → Project Settings → API
# (Project ref for zuby: nqqqygvuewuxpbaklslo)
NEXT_PUBLIC_SUPABASE_URL="https://nqqqygvuewuxpbaklslo.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# Service-role key. SERVER-SIDE ONLY — bypasses RLS.
# Used by /api/wa event logging, admin mutations (Phase 3) and /ingest (Phase 2).
# Never expose to the browser, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# Direct Postgres connection, used only by `npm run db:reset` / `db:apply`.
# Dashboard → Project Settings → Database → Connection string (URI).
# Not needed at runtime by the web app.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.nqqqygvuewuxpbaklslo.supabase.co:5432/postgres"

# Public site origin, used for canonical URLs, sitemap and OG images.
NEXT_PUBLIC_SITE_URL="https://zuby.food"

# Zuby's own WhatsApp number (E.164). Phase 4 claim flow: chefs send their
# verification code here from the kitchen's phone, and the admin matches the
# sender's number. Leave unset to hide the WhatsApp self-verification path
# (the manual claim form still works).
NEXT_PUBLIC_FOUNDER_WHATSAPP_E164="+919900000000"

# Optional: Resend API key for Phase 4 transactional email (claim decision,
# listing approved, changes requested). Unset = emails silently skipped, every
# other flow behaves identically. Get one at resend.com (free tier is plenty)
# and verify the sending domain before setting this.
RESEND_API_KEY=""
# From address for those emails. Must be on a domain verified in Resend.
RESEND_FROM="Zuby <hello@zuby.food>"

# Optional: shared secret for POST /api/revalidate (see src/app/api/revalidate).
# Generate any random string; required only once something calls that route.
REVALIDATE_SECRET="change-me"

# Optional: Search Console / Bing Webmaster ownership via the HTML meta-tag
# method (docs/seo-playbook.md Part 1). The DNS TXT method already verifies
# the whole domain without these — set them only if you want the meta-tag
# path too (e.g. Bing's non-import flow, or a URL-prefix property). Each
# console gives you a short token, not a secret; safe to leave unset.
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""
