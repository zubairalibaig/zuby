# ---------------------------------------------------------------------------
# Zuby environment variables. Copy to .env.local and fill in.
# NEVER commit .env.local — it is gitignored.
# ---------------------------------------------------------------------------

# Supabase project URL and anon key.
# Dashboard → Project Settings → API
# (Project ref for zuby: nqqqygvuewuxpbaklslo)
NEXT_PUBLIC_SUPABASE_URL="https://nqqqygvuewuxpbaklslo.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# Service-role key. SERVER-SIDE ONLY — bypasses RLS.
# Used by /api/wa event logging, admin mutations (Phase 3) and /ingest (Phase 2).
# Never expose to the browser, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# Direct Postgres connection, used only by `npm run db:reset` / `db:apply`.
# Dashboard → Project Settings → Database → Connection string (URI).
# Not needed at runtime by the web app.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.nqqqygvuewuxpbaklslo.supabase.co:5432/postgres"

# Public site origin, used for canonical URLs, sitemap and OG images.
NEXT_PUBLIC_SITE_URL="https://zuby.food"

# Optional: the founder's own WhatsApp number (E.164), used only by the
# /for-chefs interim onboarding CTA until Phase 4 ships self-serve claim/create.
# Leave unset to hide that button.
NEXT_PUBLIC_FOUNDER_WHATSAPP_E164="+919900000000"

# Optional: shared secret for POST /api/revalidate (see src/app/api/revalidate).
# Generate any random string; required only once something calls that route.
REVALIDATE_SECRET="change-me"
